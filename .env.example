# ---------------------------------------------------------------------------
# AI-Native Zammad starter — copy to .env and edit.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- AI provider -----------------------------------------------------------
# Tried in order; the first one that answers wins. Drop "anthropic" to run
# fully local, or "ollama" if you only ever want the API.
AI_PROVIDER=anthropic,ollama

# Claude API. Leave blank to skip this provider entirely.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max. Triage is a short classification, so low
# is the right default — raise it only if you see routing mistakes.
ANTHROPIC_EFFORT=low

# Local models via Ollama. host.docker.internal reaches an Ollama server
# running on the machine hosting Docker.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# --- Zammad ----------------------------------------------------------------
ZAMMAD_PORT=8080
TRIAGE_PORT=8000

# API credentials for the worker. Prefer a token: create one in Zammad under
# Profile -> Token Access, or run ./scripts/smoke.sh which mints one for you.
ZAMMAD_TOKEN=
# Only used if ZAMMAD_TOKEN is empty.
ZAMMAD_USER=
ZAMMAD_PASSWORD=

# Shared secret for webhook signature verification. Set the same value in
# Zammad (Manage -> Webhook -> HMAC token). Blank disables verification —
# fine on localhost, not fine anywhere else.
ZAMMAD_WEBHOOK_SECRET=

# --- triage behaviour ------------------------------------------------------
# Must match the group names that exist in your Zammad, exactly.
TRIAGE_GROUPS=Users,2nd Level,Billing
TRIAGE_DEFAULT_GROUP=Users
TRIAGE_PRIORITIES=1 low,2 normal,3 high
TRIAGE_DEFAULT_PRIORITY=2 normal
TRIAGE_TAGS=access,billing,bug,hardware,how-to,needs-review,network,security

# Below this confidence the ticket is left untouched for a human. Start high
# and lower it once you trust the routing.
TRIAGE_CONFIDENCE_THRESHOLD=0.6

# true = classify and log, but never write to Zammad. Run this way first.
TRIAGE_DRY_RUN=false

LOG_LEVEL=INFO

# --- demo bootstrap --------------------------------------------------------
# Creates admin@example.com / zammad-demo-2026 and the three groups above on
# first start, so the stack comes up usable without clicking through setup.
# CHANGE THE PASSWORD OR DELETE THIS LINE before exposing Zammad to anything.
# Decoded contents are in scripts/autowizard.json.
AUTOWIZARD_

# Postgres credentials (only used by the bundled database container).
POSTGRES_USER=zammad
POSTGRES_PASS=zammad
POSTGRES_DB=zammad_production
